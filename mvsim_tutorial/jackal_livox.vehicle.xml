<!--
  Vehicle class definition file cho jackal với chỉ pointcloud và IMU
  Không có camera, chỉ có lidar3d (pointcloud) và IMU
-->
<vehicle:class name="jackal_livox">

  <!--  Dynamical model -->
  <dynamics class="differential_4_wheels">
    <!-- Params -->
    <lf_wheel pos="0.13  0.16" mass="1.0" width="0.03" diameter="0.20">
      <visual>
        <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri>
      </visual>
    </lf_wheel>
    <rf_wheel pos="0.13 -0.16" mass="1.0" width="0.03" diameter="0.20">
      <visual>
        <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri>
      </visual>
    </rf_wheel>
    <lr_wheel pos="-0.13  0.16" mass="1.0" width="0.03" diameter="0.20">
      <visual>
        <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri>
      </visual>
    </lr_wheel>
    <rr_wheel pos="-0.13 -0.16" mass="1.0" width="0.03" diameter="0.20">
      <visual>
        <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal-wheel.dae</model_uri>
      </visual>
    </rr_wheel>

    <chassis mass="10.0" zmin="0.05" zmax="0.25">
      <shape_from_visual/>
      <!-- automatic shape,zmin,zmax from 3D mesh-->
    </chassis>

    <!--   Motor controller -->
    <controller class="${controller|twist_ideal}">      <!-- "twist_ideal" or "twist_pid" -->
      <!-- Optimal parameters from the mvsim-pid-tuner tool -->
      <KP>20</KP>
      <KI>10</KI>
      <KD>0.0000</KD>
      <max_torque>100</max_torque>
    </controller>
  </dynamics>

  <!-- Friction force simulation -->
  <friction class="default">
    <mu>0.8</mu>
    <C_damping>0.05</C_damping>
    <C_rr>0.01</C_rr>    <!-- Rolling resistance coefficient -->
  </friction>

  <!-- Noisy odometry parameters. These are multipliers to actual SE(2) increments -->
  <odometry x_multiplier="$f{1.0+0.02*randn()}" y_multiplier="$f{1.0+0.01*randn()}" yaw_multiplier="$f{1.0+0.03*randn()}" />

  <!--  Custom visualization model -->
  <!-- 3D model filename to load (local or remote http://uri ) -->
  <visual>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../models/jackal_description/jackal.dae</model_uri>
    <model_yaw>0.0</model_yaw>
    <model_pitch>0.0</model_pitch>
    <model_roll>90.0</model_roll>
  </visual>

  <!-- Sensors: chỉ có pointcloud và IMU -->
  <!-- Pointcloud sensor (Livox lidar) - đặt tại vị trí mid360_front -->
  <include file="../mvsim_tutorial/livox_lidar.sensor.xml" sensor_x="-0.07" sensor_y="0.0" sensor_z="1.3" sensor_yaw="0" sensor_pitch="180.0" sensor_roll="0" sensor_std_noise="0.0025" sensor_publish="false" sensor_name="lidar" sensor_rate="10.0" generate_intensity="true" horz_resolution_factor="1.5" vert_resolution_factor="1.0" />

  <!-- IMU sensor - offset từ lidar theo T_lidar_imu=[0.006,-0.012,0.008] (converted to base_link frame) -->
  <include file="../mvsim_tutorial/livox_imu.sensor.xml" sensor_x="-0.076" sensor_y="-0.012" sensor_z="1.292" sensor_yaw="0" sensor_pitch="180.0" sensor_roll="0" sensor_period_sec="0.005" sensor_name="imu" sensor_angular_velocity_white_noise_std_noise="2e-4" sensor_linear_acceleration_white_noise_std_noise="0.017" sensor_measure_orientation="true" />

</vehicle:class>